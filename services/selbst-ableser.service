[Unit]
Description=selbst-ableser
After=network.target

[Service]
WorkingDirectory=/opt/selbst-ableser
ExecStart=/opt/selbst-ableser/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8282 --workers 1
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Set to "production" on a public-facing VPS (enables TrustedHostMiddleware + audit log file)
Environment=DEPLOYMENT_ENV=development
User=selbst
SupplementaryGroups=dialout
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/selbst-ableser

[Install]
WantedBy=multi-user.target
