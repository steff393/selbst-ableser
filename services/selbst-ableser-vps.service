[Unit]
Description=selbst-ableser Main API for usage on a VPS with Plesk and nginx reverse proxy
After=network.target

[Service]
WorkingDirectory=/opt/selbst-ableser
ExecStart=/opt/selbst-ableser/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8282
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=DEPLOYMENT_ENV=production
User=selbst
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/selbst-ableser

[Install]
WantedBy=multi-user.target
