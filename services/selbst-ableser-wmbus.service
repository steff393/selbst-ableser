[Unit]
Description=selbst-ableser wMBus-API (Port 8081)
After=network.target

[Service]
WorkingDirectory=/opt/selbst-ableser
ExecStart=/opt/selbst-ableser/venv/bin/uvicorn wmbus:app --host 0.0.0.0 --port 8081  --workers 1
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
User=root

[Install]
WantedBy=multi-user.target