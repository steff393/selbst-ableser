[Unit]
Description=selbst-ableser E-Mail-Versand
After=network.target

[Service]
WorkingDirectory=/opt/selbst-ableser
ExecStart=/opt/selbst-ableser/venv/bin/python email_sender.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
User=selbst
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/selbst-ableser

[Install]
WantedBy=multi-user.target
